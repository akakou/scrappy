{
    "name": "Scrappy",
    "description": "SeCure Rate Assuring Protocol with PrivacY",
    "version": "0.1",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "http://localhost:8081/*"
            ],
            "js": [
                "frontend.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "nativeMessaging"
    ]
}
